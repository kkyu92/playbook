# Playbook Hub — 환경변수 템플릿
# 복사 후 실값 입력: cp .env.example .env.local
# .env.local 은 gitignore 됨 (.env*.local 패턴)

# ───────────────────────────────────────────
# 관리자 인증 (필수)
# ───────────────────────────────────────────

# /admin 로그인 비밀번호 — 최소 8자
ADMIN_PASSWORD=change-me-at-least-8-chars

# HMAC 쿠키 서명 시크릿 — 최소 16자, 랜덤 문자열 권장
# 생성 팁: openssl rand -hex 32
ADMIN_SECRET=change-me-min-16-chars-random-hex

# ───────────────────────────────────────────
# GitHub 통합 (필수 — /api/admin entry CRUD)
# ───────────────────────────────────────────

# Classic PAT with scope: repo (playbook write)
# 만료 없음 또는 장기. Fine-grained PAT 로도 가능하나 Classic 이 유연
GITHUB_TOKEN=ghp_your_classic_pat_here

# 레포 경로 (owner/name). 본인 fork 면 변경 필요
GITHUB_REPO=kkyu92/playbook

# ───────────────────────────────────────────
# Gemini API (필수 — daily-lesson cron + /api/ai)
# ───────────────────────────────────────────

# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=your-gemini-api-key

# ───────────────────────────────────────────
# 선택 — 커스텀 도메인 / OG image
# ───────────────────────────────────────────

# 미설정 시 기본값: https://playbook-virid-xi.vercel.app
# 커스텀 도메인 연결 후 설정 권장 (sitemap / RSS / OG image 에 반영)
# NEXT_PUBLIC_SITE_URL=https://your-custom-domain.com

# ───────────────────────────────────────────
# 선택 — Upstash Redis (auth rate-limit, production 권장)
# ───────────────────────────────────────────

# Vercel Marketplace → Upstash Redis 연동 시 자동 주입.
# 미설정 시 in-memory fallback (dev OK / production 은 serverless 다중 인스턴스 우회 가능).
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=...
